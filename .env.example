# ── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://st_user:st_pass@localhost:5432/standardotvoryets"

# ── NEXTAUTH ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""          # generate: openssl rand -base64 32

# ── S3 / MINIO ─────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"   # MinIO local; AWS S3 in prod → leave empty
S3_REGION="eu-central-1"
S3_BUCKET="standardotvoryets"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ── REDIS ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── EMAIL ─────────────────────────────────────────────────
EMAIL_FROM="noreply@standardotvoryets.gov.ua"

# Option A: Resend (recommended for prod)
RESEND_API_KEY=""

# Option B: SMTP (fallback / dev)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── APP ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Стандартотворець"

# ── FEATURE FLAGS ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DIFF_VIEWER="false"   # set true when module ready
