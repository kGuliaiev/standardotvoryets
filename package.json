    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "ioredis": "^5.4.1",
    "lucide-react": "0.383.0",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-big-calendar": "^1.13.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
