generator client {
  provider = "prisma-client-js"
  // Bake the engine for the Railway runtime (Debian bookworm / OpenSSL
  // 3.0) into the image at build time. Without this Prisma only ships
  // the build host's "native" engine; if the startup `prisma db push`
  // (which regenerates) fails — e.g. DB unreachable during a Postgres
  // outage — the container is left with no usable query engine and
  // every query throws "could not locate the Query Engine for runtime
  // debian-openssl-3.0.x".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum GlobalRole {
  ADMIN
  DIRECTOR  // Керівник центру — повний доступ до РГ, членом яких є
  USER
}

enum WorkingGroupRole {
  LEADER     // Керівник РГ
  DEPUTY     // Заступник керівника
  SECRETARY  // Секретар засідань
  MEMBER     // Учасник РГ
  GUEST      // Запрошений експерт / Спостерігач
}

enum StandardStatus {
  DRAFT
  IN_REVIEW
  VOTING
  ADOPTED
  REJECTED
  ARCHIVED
}

enum DocumentType {
  DRAFT_STANDARD  // Чернетка стандарту
  TECH_SPEC       // ТЗ (технічне завдання)
  FEEDBACK        // Відгук
  MEETING_MINUTES // Протокол засідання
  AGENDA          // Порядок денний
  ATTACHMENT      // Додатковий матеріал
  FINAL           // Фінальна версія
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum VoteStatus {
  OPEN
  CLOSED
}

enum MeetingFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum MeetingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  MEETING_INVITE
  MEETING_REMINDER
  VOTE_OPENED
  VOTE_CLOSED
  DOCUMENT_UPLOADED
  COMMENT_ADDED
  TASK_ASSIGNED
  TASK_OVERDUE
  STANDARD_STATUS_CHANGED
  STAGE_DUE_SOON
  STAGE_OVERDUE
  STAGE_COMPLETED
  WEEKLY_DIGEST
  ATTENDANCE_DECLINED
  PROTOCOL_PUBLISHED
  MENTION
  SUGGESTION_NEW
  SUGGESTION_RESOLVED
}

enum MilitaryRank {
  CIVILIAN
  LIEUTENANT          // лейтенант
  SENIOR_LIEUTENANT   // старший лейтенант
  CAPTAIN             // капітан
  MAJOR               // майор
  LIEUTENANT_COLONEL  // підполковник
  COLONEL             // полковник
  BRIGADIER_GENERAL   // бригадний генерал
  MAJOR_GENERAL       // генерал-майор
  LIEUTENANT_GENERAL  // генерал-лейтенант
  GENERAL             // генерал
}

enum Organization {
  DERZH_NDI           // ДержНДІ технологій кібербезпеки
  ADM_DSSZZI          // Адміністрація Держспецзв'язку
  OTHER
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  globalRole   GlobalRole    @default(USER)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  rank         MilitaryRank  @default(CIVILIAN)
  position     String?       // free-text: посада
  organization Organization  @default(OTHER)
  phone        String?
  // Per-user notification toggles (overrides system defaults if set)
  notifyEmail  Boolean       @default(true)
  notifyInApp  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  memberships     WorkingGroupMember[]
  documents       Document[]
  comments        Comment[]
  votes           Vote[]
  tasksAssigned     Task[]         @relation("TaskAssignee")
  tasksCreated      Task[]         @relation("TaskCreator")
  tasksCompleted    Task[]         @relation("TaskCompleter")
  agendaSpoke       AgendaItem[]   @relation("AgendaSpeaker")
  agendaResponsible AgendaItem[]   @relation("AgendaResponsible")
  meetingsCreated  Meeting[]      @relation("MeetingCreator")
  meetingsChaired  Meeting[]      @relation("MeetingChairman")
  attendances     Attendance[]
  notifications   Notification[]
  sessions        Session[]
  accounts        Account[]
  standards            Standard[]
  standardBodiesEdited Standard[]              @relation("StandardBodyEditor")
  documentBodiesEdited Document[]              @relation("DocumentBodyEditor")
  suggestionsCreated   StandardSuggestion[]    @relation("SuggestionAuthor")
  suggestionsResolved  StandardSuggestion[]    @relation("SuggestionResolver")
  suggestionReactions  SuggestionReaction[]
  inlineCommentsCreated   InlineComment[]      @relation("InlineCommentAuthor")
  inlineCommentsResolved  InlineComment[]      @relation("InlineCommentResolver")
  inlineCommentReplies    InlineCommentReply[] @relation("InlineCommentReplyAuthor")
  activityLogs    ActivityLog[]
  statusChanges   StandardStatusHistory[] @relation("StatusChanger")

  @@map("users")
}

// ─────────────────────────────────────────
// ACTIVITY LOG (audit trail)
// ─────────────────────────────────────────

/// Optional per-(role, action) override for the RBAC matrix in
/// src/lib/rbac.ts. When a row exists it wins over the hardcoded
/// default; when absent the hardcoded list applies. Admin always
/// gets every permission (short-circuit in `can()` — not stored
/// here).
model RolePermission {
  // String (not the WorkingGroupRole enum) so the matrix can also hold
  // the global "DIRECTOR" pseudo-role column alongside the WG roles.
  role      String
  action    String
  allowed   Boolean
  updatedAt DateTime @updatedAt

  @@id([role, action])
  @@map("role_permissions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | ARCHIVE | RESTORE
  entity    String   // Standard | Meeting | Task | WorkingGroup | User | Document
  entityId  String
  before    Json?
  after     Json?
  diff      Json?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_log")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model InviteToken {
  id             String           @id @default(cuid())
  token          String           @unique @default(cuid())
  email          String
  workingGroupId String
  role           WorkingGroupRole
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime         @default(now())
  workingGroup   WorkingGroup     @relation(fields: [workingGroupId], references: [id])

  @@map("invite_tokens")
}

// ─────────────────────────────────────────
// WORKING GROUPS
// ─────────────────────────────────────────

model WorkingGroup {
  id          String   @id @default(cuid())
  code        String   @unique // "РГ №8"
  name        String // "Управління якістю"
  description String?
  color       String   @default("#1A56DB") // hex, for UI
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members   WorkingGroupMember[]
  standards Standard[]
  meetings  Meeting[]
  invites   InviteToken[]

  @@map("working_groups")
}

model WorkingGroupMember {
  id             String           @id @default(cuid())
  workingGroupId String
  userId         String
  role           WorkingGroupRole
  joinedAt       DateTime         @default(now())

  workingGroup WorkingGroup @relation(fields: [workingGroupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workingGroupId, userId])
  @@map("working_group_members")
}

// ─────────────────────────────────────────
// STANDARDS
// ─────────────────────────────────────────

model Standard {
  id             String         @id @default(cuid())
  workingGroupId String
  code           String // "ДСТУ 7.1"
  title          String // "Вимоги до документації..."
  description    String?
  status         StandardStatus @default(DRAFT)
  isoAnalog      String? // "ISO 9001:2015"
  category       String? // "Управління якістю"
  deadline       DateTime?
  responsibleId  String?
  progress       Int            @default(0) // 0–100

  // Поетапний план виконання (Програма стандартизації)
  currentStage      StandardStage @default(TECH_SPEC)
  techSpecDueDate   DateTime?    // Розроблення та погодження ТЗ
  draftDueDate      DateTime?    // Розроблення проєкту стандарту
  feedbackDueDate   DateTime?    // Отримання та опрацювання відгуків
  techReviewDueDate DateTime?    // Технічна перевірка проєкту стандарту
  finalDueDate      DateTime?    // Остаточний термін виконання

  // Метадані з Програми (для звіту)
  partProgram   String?  // "Частина 1" / "Частина 2"
  programNumber Int?     // № в Програмі
  indeks        String?  // "СТД-100-200-001-2026-В"
  oldTitle      String?  // Стара назва стандарту

  techSpecCompletedAt   DateTime?
  draftCompletedAt      DateTime?
  feedbackCompletedAt   DateTime?
  techReviewCompletedAt DateTime?
  finalCompletedAt      DateTime?

  // Collaborative body of the standard. Paragraphs are split by "\n\n".
  // Suggestions reference paragraph indices (StandardSuggestion).
  bodyText           String?
  bodyUpdatedAt      DateTime?
  bodyUpdatedById    String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workingGroup  WorkingGroup            @relation(fields: [workingGroupId], references: [id])
  responsible   User?                   @relation(fields: [responsibleId], references: [id])
  bodyUpdatedBy User?                   @relation("StandardBodyEditor", fields: [bodyUpdatedById], references: [id])
  documents     Document[]
  comments      Comment[]
  votes         Voting[]
  tasks          Task[]
  statusHistory  StandardStatusHistory[]
  suggestions    StandardSuggestion[]
  inlineComments InlineComment[]

  @@unique([workingGroupId, code])
  @@map("standards")
}

// Collaborative edit suggestion against a Standard's bodyText.
// Any WG member can create one; LEADER/DEPUTY/SECRETARY resolve.
// Other members may LIKE/DISLIKE for advisory weight (no quorum gate).
/// Suggestion attached either to a Standard's bodyText or a Document's
/// bodyHtml. Exactly one of standardId / documentId is set — enforced in
/// application code at the router layer.
model StandardSuggestion {
  id              String              @id @default(cuid())
  /// Set when the edit targets a Standard's bodyText. Mutually exclusive
  /// with documentId.
  standardId      String?
  /// Set when the edit targets a Document's bodyHtml. Mutually exclusive
  /// with standardId.
  documentId      String?
  authorId        String
  paragraphIndex  Int                 // 0-based index into split blocks at creation time
  originalText    String              // snapshot of paragraph as it was when suggestion made
  proposedText    String              // empty string = "delete this paragraph"
  operation       SuggestionOp        @default(REPLACE)
  rationale       String?
  status          SuggestionStatus    @default(PENDING)
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolveNote     String?

  standard        Standard?           @relation(fields: [standardId], references: [id], onDelete: Cascade)
  document        Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author          User                @relation("SuggestionAuthor", fields: [authorId], references: [id])
  resolvedBy      User?               @relation("SuggestionResolver", fields: [resolvedById], references: [id])
  reactions       SuggestionReaction[]

  @@index([standardId, status])
  @@index([documentId, status])
  @@map("standard_suggestions")
}

model SuggestionReaction {
  suggestionId String
  userId       String
  type         ReactionType
  createdAt    DateTime @default(now())

  suggestion   StandardSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id])

  @@id([suggestionId, userId])
  @@map("suggestion_reactions")
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SuggestionOp {
  REPLACE       // proposedText replaces originalText
  INSERT_AFTER  // proposedText is a new paragraph inserted after paragraphIndex
  DELETE        // remove paragraph at paragraphIndex (proposedText must be "")
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum StandardStage {
  TECH_SPEC      // 1. Розроблення та погодження ТЗ
  DRAFTING       // 2. Розроблення проєкту стандарту
  FEEDBACK       // 3. Отримання та опрацювання відгуків
  TECH_REVIEW    // 4. Технічна перевірка проєкту стандарту
  FINALIZATION   // 5. Остаточний термін виконання
  COMPLETED      // Завершено
}

model StandardStatusHistory {
  id          String         @id @default(cuid())
  standardId  String
  fromStatus  StandardStatus?
  toStatus    StandardStatus
  changedById String
  note        String?
  changedAt   DateTime       @default(now())

  standard  Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  changedBy User     @relation("StatusChanger", fields: [changedById], references: [id])

  @@map("standard_status_history")
}

// ─────────────────────────────────────────
// DOCUMENTS (versioned)
// ─────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  standardId   String
  uploadedById String
  type         DocumentType
  filename     String
  /// Object-storage key for documents uploaded from a file. Null for
  /// documents created empty in the editor — those live only as
  /// bodyHtml until exported.
  s3Key        String?      @unique
  sizeBytes    Int          @default(0)
  version      String // "v0.4"
  isCurrent    Boolean      @default(false)
  note         String? // "What changed in this version"
  createdAt    DateTime     @default(now())

  /// When true, members can propose paragraph-level edits via the
  /// suggestion mechanism (only meaningful for .docx — bodyHtml below is
  /// populated only in that case).
  allowEdits   Boolean      @default(false)
  /// HTML extracted from the uploaded .docx (via mammoth) when allowEdits
  /// is set. Same TipTap-compatible schema as Standard.bodyText.
  bodyHtml         String?       @db.Text
  bodyUpdatedAt    DateTime?
  bodyUpdatedById  String?
  bodyUpdatedBy    User?         @relation("DocumentBodyEditor", fields: [bodyUpdatedById], references: [id])

  standard       Standard             @relation(fields: [standardId], references: [id], onDelete: Cascade)
  uploadedBy     User                 @relation(fields: [uploadedById], references: [id])
  suggestions    StandardSuggestion[]
  inlineComments InlineComment[]

  @@map("documents")
}

// ─────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────

model Comment {
  id         String   @id @default(cuid())
  standardId String
  authorId   String
  body       String   @db.Text
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  standard Standard  @relation(fields: [standardId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@map("comments")
}

/// Inline comment anchored to a text selection inside a body block
/// (paragraph, heading, list item, …). Like Google Docs comments —
/// users select text and leave feedback that doesn't propose a textual
/// change (otherwise they'd use StandardSuggestion).
///
/// Polymorphic parent: exactly one of standardId / documentId is set,
/// matching the StandardSuggestion convention so the same UI can target
/// either the standard's main body or a per-document editable body.
///
/// Anchor: paragraphIndex + char offsets within that block's plain
/// text. `selectionText` is a snapshot so the comment can be re-anchored
/// (best-effort) if the underlying text shifts.
model InlineComment {
  id             String                @id @default(cuid())
  /// Set when the comment targets a Standard's main bodyText.
  standardId     String?
  /// Set when the comment targets a Document's bodyHtml.
  documentId     String?
  authorId       String
  paragraphIndex Int
  startOffset    Int
  endOffset      Int
  /// Plain-text snapshot of the originally-selected range. Used to
  /// re-anchor (or mark stale) when the block changes.
  selectionText  String                @db.Text
  body           String                @db.Text
  status         InlineCommentStatus   @default(OPEN)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  resolvedAt     DateTime?
  resolvedById   String?

  standard   Standard?              @relation(fields: [standardId], references: [id], onDelete: Cascade)
  document   Document?              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User                   @relation("InlineCommentAuthor", fields: [authorId], references: [id])
  resolvedBy User?                  @relation("InlineCommentResolver", fields: [resolvedById], references: [id])
  replies    InlineCommentReply[]

  @@index([standardId, status])
  @@index([documentId, status])
  @@map("inline_comments")
}

model InlineCommentReply {
  id         String        @id @default(cuid())
  commentId  String
  authorId   String
  body       String        @db.Text
  createdAt  DateTime      @default(now())

  comment    InlineComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author     User          @relation("InlineCommentReplyAuthor", fields: [authorId], references: [id])

  @@index([commentId])
  @@map("inline_comment_replies")
}

enum InlineCommentStatus {
  OPEN
  RESOLVED
}

// ─────────────────────────────────────────
// VOTING
// ─────────────────────────────────────────

model Voting {
  id          String     @id @default(cuid())
  standardId  String
  title       String
  description String?
  status      VoteStatus @default(OPEN)
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  deadline    DateTime?

  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@map("votings")
}

model Vote {
  id       String     @id @default(cuid())
  votingId String
  userId   String
  choice   VoteChoice
  comment  String?
  votedAt  DateTime   @default(now())

  voting Voting @relation(fields: [votingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([votingId, userId])
  @@map("votes")
}

// ─────────────────────────────────────────
// MEETINGS
// ─────────────────────────────────────────

model Meeting {
  id             String        @id @default(cuid())
  workingGroupId String
  createdById    String
  chairmanId     String?
  protocolNumber Int? // sequence per WG per year, e.g. 1 → "1/4/2026"
  title          String
  format         MeetingFormat @default(ONLINE)
  location       String? // URL or room name
  startAt        DateTime
  durationMins   Int           @default(60)
  status         MeetingStatus @default(PLANNED)
  agendaText     String?       @db.Text
  minutesText    String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workingGroup WorkingGroup @relation(fields: [workingGroupId], references: [id])
  createdBy    User         @relation("MeetingCreator", fields: [createdById], references: [id])
  chairman     User?        @relation("MeetingChairman", fields: [chairmanId], references: [id])
  attendances  Attendance[]
  agendaItems  AgendaItem[]

  @@map("meetings")
}

model AgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  order     Int
  title     String
  duration  Int? // minutes
  note      String?

  // Section of the protocol this item belongs to. The protocol has three
  // independent lists (AGENDA / HEARD / DECISION) — they're not 1:1 mapped
  // to each other anymore (агенда може мати 2 теми, а виступів — 5).
  section AgendaItemSection @default(AGENDA)

  // Protocol fields (the editor uses different ones per section, but the
  // columns stay unified to keep the schema flat).
  speakerId       String?
  // Free-text доповідач / відповідальний — used when the person is NOT in the
  // WG roster (e.g. an external presenter). When the FK (speakerId /
  // responsibleId) is set it wins; otherwise these names are rendered.
  speakerName     String?
  heardText       String?  @db.Text // СЛУХАЛИ
  discussionText  String?  @db.Text // ВИСТУПИЛИ
  decisionText    String?  @db.Text // ВИРІШИЛИ
  deadline        DateTime?
  responsibleId   String?
  responsibleName String?

  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker     User?   @relation("AgendaSpeaker", fields: [speakerId], references: [id])
  responsible User?   @relation("AgendaResponsible", fields: [responsibleId], references: [id])

  @@map("agenda_items")
}

enum AgendaItemSection {
  AGENDA   // Порядок денний (title + speaker)
  HEARD    // Слухали / Виступили (heardText + discussionText)
  DECISION // Вирішили (decisionText + deadline + responsible)
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus @default(PENDING)
  note      String?
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@map("attendances")
}

// ─────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────

model Task {
  id            String       @id @default(cuid())
  standardId    String
  createdById   String
  assigneeId    String?
  completedById String?
  title         String
  description   String?      @db.Text
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(OPEN)
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TaskCreator", fields: [createdById], references: [id])
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy User?    @relation("TaskCompleter", fields: [completedById], references: [id])

  @@map("tasks")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String? // e.g. /standards/abc123
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─────────────────────────────────────────
// SYSTEM SETTINGS (singleton row, id = 1)
// ─────────────────────────────────────────

model SystemSettings {
  id                        Int      @id @default(1)

  // ── Meetings: when to remind ──
  meetingRemindLead1Hours   Int      @default(24)   // primary reminder (e.g. day before)
  meetingRemindLead2Hours   Int?     @default(1)    // secondary reminder (e.g. hour before)
  meetingInviteOnCreate     Boolean  @default(true) // notify on meeting creation
  meetingChangeNotify       Boolean  @default(true) // notify on date/agenda change

  // ── Tasks: when to remind ──
  taskAssignNotify          Boolean  @default(true) // notify assignee on assignment
  taskDeadlineLeadHours     Int      @default(24)   // remind N hours before due
  taskOverdueNotify         Boolean  @default(true) // notify on missed deadline
  taskCompleteNotify        Boolean  @default(true) // notify creator on completion

  // ── Votes / standards / comments ──
  voteOpenedNotify          Boolean  @default(true)
  voteClosingLeadHours      Int      @default(24)   // remind before close
  voteClosedNotify          Boolean  @default(true)
  standardStatusNotify      Boolean  @default(true)
  commentMentionNotify      Boolean  @default(true)
  documentUploadNotify      Boolean  @default(false)

  // ── Stages of program-plan standards ──
  stageDueSoonNotify        Boolean  @default(true)  // remind before stage deadline
  stageDueLeadDays1         Int      @default(7)     // first reminder (in-app only)
  stageDueLeadDays2         Int      @default(1)     // second reminder (in-app + email to leads)
  stageOverdueNotify        Boolean  @default(true)  // one-shot when stage misses deadline
  stageCompletedNotify      Boolean  @default(true)  // notify leadership when stage confirmed
  weeklyDigestEnabled       Boolean  @default(true)  // Monday 09:00 Kyiv digest to leadership

  // ── Meetings: secondary events ──
  attendanceDeclinedNotify  Boolean  @default(true)  // alert chairman+secretary when member declines
  protocolPublishedNotify   Boolean  @default(true)  // alert WG when protocol number is assigned

  // ── Channels (system defaults; user can override per-user) ──
  channelEmail              Boolean  @default(true)
  channelInApp              Boolean  @default(true)

  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}
