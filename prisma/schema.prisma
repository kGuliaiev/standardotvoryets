generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum GlobalRole {
  ADMIN
  DIRECTOR  // Керівник центру — повний доступ до РГ, членом яких є
  USER
}

enum WorkingGroupRole {
  LEADER     // Керівник РГ
  DEPUTY     // Заступник керівника
  SECRETARY  // Секретар засідань
  MEMBER     // Учасник РГ
  GUEST      // Запрошений експерт / Спостерігач
}

enum StandardStatus {
  DRAFT
  IN_REVIEW
  VOTING
  ADOPTED
  REJECTED
  ARCHIVED
}

enum DocumentType {
  DRAFT_STANDARD  // Чернетка стандарту
  MEETING_MINUTES // Протокол засідання
  AGENDA          // Порядок денний
  ATTACHMENT      // Додатковий матеріал
  FINAL           // Фінальна версія
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum VoteStatus {
  OPEN
  CLOSED
}

enum MeetingFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum MeetingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  MEETING_INVITE
  MEETING_REMINDER
  VOTE_OPENED
  VOTE_CLOSED
  DOCUMENT_UPLOADED
  COMMENT_ADDED
  TASK_ASSIGNED
  TASK_OVERDUE
  STANDARD_STATUS_CHANGED
}

enum MilitaryRank {
  CIVILIAN
  LIEUTENANT          // лейтенант
  SENIOR_LIEUTENANT   // старший лейтенант
  CAPTAIN             // капітан
  MAJOR               // майор
  LIEUTENANT_COLONEL  // підполковник
  COLONEL             // полковник
  BRIGADIER_GENERAL   // бригадний генерал
  MAJOR_GENERAL       // генерал-майор
  LIEUTENANT_GENERAL  // генерал-лейтенант
  GENERAL             // генерал
}

enum Organization {
  DERZH_NDI           // ДержНДІ технологій кібербезпеки
  ADM_DSSZZI          // Адміністрація Держспецзв'язку
  OTHER
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  globalRole   GlobalRole    @default(USER)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  rank         MilitaryRank  @default(CIVILIAN)
  position     String?       // free-text: посада
  organization Organization  @default(OTHER)
  phone        String?
  // Per-user notification toggles (overrides system defaults if set)
  notifyEmail  Boolean       @default(true)
  notifyInApp  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  memberships     WorkingGroupMember[]
  documents       Document[]
  comments        Comment[]
  votes           Vote[]
  tasksAssigned     Task[]         @relation("TaskAssignee")
  tasksCreated      Task[]         @relation("TaskCreator")
  tasksCompleted    Task[]         @relation("TaskCompleter")
  agendaSpoke       AgendaItem[]   @relation("AgendaSpeaker")
  agendaResponsible AgendaItem[]   @relation("AgendaResponsible")
  meetingsCreated  Meeting[]      @relation("MeetingCreator")
  meetingsChaired  Meeting[]      @relation("MeetingChairman")
  attendances     Attendance[]
  notifications   Notification[]
  sessions        Session[]
  accounts        Account[]
  standards       Standard[]
  activityLogs    ActivityLog[]
  statusChanges   StandardStatusHistory[] @relation("StatusChanger")

  @@map("users")
}

// ─────────────────────────────────────────
// ACTIVITY LOG (audit trail)
// ─────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | ARCHIVE | RESTORE
  entity    String   // Standard | Meeting | Task | WorkingGroup | User | Document
  entityId  String
  before    Json?
  after     Json?
  diff      Json?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_log")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model InviteToken {
  id             String           @id @default(cuid())
  token          String           @unique @default(cuid())
  email          String
  workingGroupId String
  role           WorkingGroupRole
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime         @default(now())
  workingGroup   WorkingGroup     @relation(fields: [workingGroupId], references: [id])

  @@map("invite_tokens")
}

// ─────────────────────────────────────────
// WORKING GROUPS
// ─────────────────────────────────────────

model WorkingGroup {
  id          String   @id @default(cuid())
  code        String   @unique // "РГ №8"
  name        String // "Управління якістю"
  description String?
  color       String   @default("#1A56DB") // hex, for UI
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members   WorkingGroupMember[]
  standards Standard[]
  meetings  Meeting[]
  invites   InviteToken[]

  @@map("working_groups")
}

model WorkingGroupMember {
  id             String           @id @default(cuid())
  workingGroupId String
  userId         String
  role           WorkingGroupRole
  joinedAt       DateTime         @default(now())

  workingGroup WorkingGroup @relation(fields: [workingGroupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workingGroupId, userId])
  @@map("working_group_members")
}

// ─────────────────────────────────────────
// STANDARDS
// ─────────────────────────────────────────

model Standard {
  id             String         @id @default(cuid())
  workingGroupId String
  code           String // "ДСТУ 7.1"
  title          String // "Вимоги до документації..."
  description    String?
  status         StandardStatus @default(DRAFT)
  isoAnalog      String? // "ISO 9001:2015"
  category       String? // "Управління якістю"
  deadline       DateTime?
  responsibleId  String?
  progress       Int            @default(0) // 0–100

  // Поетапний план виконання (Програма стандартизації)
  currentStage      StandardStage @default(TECH_SPEC)
  techSpecDueDate   DateTime?    // Розроблення та погодження ТЗ
  draftDueDate      DateTime?    // Розроблення проєкту стандарту
  feedbackDueDate   DateTime?    // Отримання та опрацювання відгуків
  techReviewDueDate DateTime?    // Технічна перевірка проєкту стандарту
  finalDueDate      DateTime?    // Остаточний термін виконання

  // Метадані з Програми (для звіту)
  partProgram   String?  // "Частина 1" / "Частина 2"
  programNumber Int?     // № в Програмі
  indeks        String?  // "СТД-100-200-001-2026-В"
  oldTitle      String?  // Стара назва стандарту

  techSpecCompletedAt   DateTime?
  draftCompletedAt      DateTime?
  feedbackCompletedAt   DateTime?
  techReviewCompletedAt DateTime?
  finalCompletedAt      DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workingGroup  WorkingGroup            @relation(fields: [workingGroupId], references: [id])
  responsible   User?                   @relation(fields: [responsibleId], references: [id])
  documents     Document[]
  comments      Comment[]
  votes         Voting[]
  tasks         Task[]
  statusHistory StandardStatusHistory[]

  @@unique([workingGroupId, code])
  @@map("standards")
}

enum StandardStage {
  TECH_SPEC      // 1. Розроблення та погодження ТЗ
  DRAFTING       // 2. Розроблення проєкту стандарту
  FEEDBACK       // 3. Отримання та опрацювання відгуків
  TECH_REVIEW    // 4. Технічна перевірка проєкту стандарту
  FINALIZATION   // 5. Остаточний термін виконання
  COMPLETED      // Завершено
}

model StandardStatusHistory {
  id          String         @id @default(cuid())
  standardId  String
  fromStatus  StandardStatus?
  toStatus    StandardStatus
  changedById String
  note        String?
  changedAt   DateTime       @default(now())

  standard  Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  changedBy User     @relation("StatusChanger", fields: [changedById], references: [id])

  @@map("standard_status_history")
}

// ─────────────────────────────────────────
// DOCUMENTS (versioned)
// ─────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  standardId   String
  uploadedById String
  type         DocumentType
  filename     String
  s3Key        String       @unique
  sizeBytes    Int
  version      String // "v0.4"
  isCurrent    Boolean      @default(false)
  note         String? // "What changed in this version"
  createdAt    DateTime     @default(now())

  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

// ─────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────

model Comment {
  id         String   @id @default(cuid())
  standardId String
  authorId   String
  body       String   @db.Text
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  standard Standard  @relation(fields: [standardId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@map("comments")
}

// ─────────────────────────────────────────
// VOTING
// ─────────────────────────────────────────

model Voting {
  id          String     @id @default(cuid())
  standardId  String
  title       String
  description String?
  status      VoteStatus @default(OPEN)
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  deadline    DateTime?

  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@map("votings")
}

model Vote {
  id       String     @id @default(cuid())
  votingId String
  userId   String
  choice   VoteChoice
  comment  String?
  votedAt  DateTime   @default(now())

  voting Voting @relation(fields: [votingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([votingId, userId])
  @@map("votes")
}

// ─────────────────────────────────────────
// MEETINGS
// ─────────────────────────────────────────

model Meeting {
  id             String        @id @default(cuid())
  workingGroupId String
  createdById    String
  chairmanId     String?
  protocolNumber Int? // sequence per WG per year, e.g. 1 → "1/4/2026"
  title          String
  format         MeetingFormat @default(ONLINE)
  location       String? // URL or room name
  startAt        DateTime
  durationMins   Int           @default(60)
  status         MeetingStatus @default(PLANNED)
  agendaText     String?       @db.Text
  minutesText    String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workingGroup WorkingGroup @relation(fields: [workingGroupId], references: [id])
  createdBy    User         @relation("MeetingCreator", fields: [createdById], references: [id])
  chairman     User?        @relation("MeetingChairman", fields: [chairmanId], references: [id])
  attendances  Attendance[]
  agendaItems  AgendaItem[]

  @@map("meetings")
}

model AgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  order     Int
  title     String
  duration  Int? // minutes
  note      String?

  // Protocol fields
  speakerId       String?
  heardText       String?  @db.Text // СЛУХАЛИ
  discussionText  String?  @db.Text // ВИСТУПИЛИ
  decisionText    String?  @db.Text // ВИРІШИЛИ
  deadline        DateTime?
  responsibleId   String?

  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker     User?   @relation("AgendaSpeaker", fields: [speakerId], references: [id])
  responsible User?   @relation("AgendaResponsible", fields: [responsibleId], references: [id])

  @@map("agenda_items")
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus @default(PENDING)
  note      String?
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@map("attendances")
}

// ─────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────

model Task {
  id            String       @id @default(cuid())
  standardId    String
  createdById   String
  assigneeId    String?
  completedById String?
  title         String
  description   String?      @db.Text
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(OPEN)
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TaskCreator", fields: [createdById], references: [id])
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy User?    @relation("TaskCompleter", fields: [completedById], references: [id])

  @@map("tasks")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String? // e.g. /standards/abc123
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─────────────────────────────────────────
// SYSTEM SETTINGS (singleton row, id = 1)
// ─────────────────────────────────────────

model SystemSettings {
  id                        Int      @id @default(1)

  // ── Meetings: when to remind ──
  meetingRemindLead1Hours   Int      @default(24)   // primary reminder (e.g. day before)
  meetingRemindLead2Hours   Int?     @default(1)    // secondary reminder (e.g. hour before)
  meetingInviteOnCreate     Boolean  @default(true) // notify on meeting creation
  meetingChangeNotify       Boolean  @default(true) // notify on date/agenda change

  // ── Tasks: when to remind ──
  taskAssignNotify          Boolean  @default(true) // notify assignee on assignment
  taskDeadlineLeadHours     Int      @default(24)   // remind N hours before due
  taskOverdueNotify         Boolean  @default(true) // notify on missed deadline
  taskCompleteNotify        Boolean  @default(true) // notify creator on completion

  // ── Votes / standards / comments ──
  voteOpenedNotify          Boolean  @default(true)
  voteClosingLeadHours      Int      @default(24)   // remind before close
  voteClosedNotify          Boolean  @default(true)
  standardStatusNotify      Boolean  @default(true)
  commentMentionNotify      Boolean  @default(true)
  documentUploadNotify      Boolean  @default(false)

  // ── Channels (system defaults; user can override per-user) ──
  channelEmail              Boolean  @default(true)
  channelInApp              Boolean  @default(true)

  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}
